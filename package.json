{
  "name": "mhrise-build-tools",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "Core build-planning and equipment-reuse optimizer for Monster Hunter Rise: Sunbreak",
  "author": "jinghaihan",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -F @mhrise-build/web dev",
    "deps": "taze major -I",
    "knip": "knip",
    "lint": "eslint .",
    "locales:sync": "node scripts/sync-localizations.mjs",
    "prepare": "simple-git-hooks",
    "sources:sync": "node scripts/sync-sources.mjs",
    "test": "pnpm --recursive --if-present test",
    "test:run": "pnpm --recursive --if-present test:run",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "vite": "catalog:build",
    "knip": "catalog:dev",
    "pncat": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "typescript": "catalog:dev",
    "@unocss/preset-icons": "catalog:frontend",
    "@unocss/reset": "catalog:frontend",
    "@unocss/transformer-directives": "catalog:frontend",
    "@vitejs/plugin-vue": "catalog:frontend",
    "unocss": "catalog:frontend",
    "vue-tsc": "catalog:frontend",
    "@octohash/eslint-config": "catalog:lint",
    "eslint": "catalog:lint",
    "lint-staged": "catalog:lint",
    "xlsx": "catalog:prod",
    "vitest": "catalog:test",
    "@types/node": "catalog:types"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
